{
  "manifest_version": 3,
  "name": "KP Jump",
  "version": "1.0.0",
  "description": "Кнопка на карточке Кинопоиска: переход на выбранный вами сервис (TMDB, IMDb, Letterboxd, JustWatch).",
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.kinopoisk.ru/*"
      ],
      "js": [
        "presets.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "KP Jump: настройки"
  },
  "background": {
    "service_worker": "background.js"
  }
}